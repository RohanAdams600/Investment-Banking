# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in. Never commit real values.
# Full descriptions of every variable live in docs/environment.md.
# ---------------------------------------------------------------------------

# --- Brand -----------------------------------------------------------------
# The company name is not hard-coded anywhere; it is read from here.
NEXT_PUBLIC_BRAND_NAME="Ashlar"
NEXT_PUBLIC_BRAND_TAGLINE="The marketplace for buying and selling businesses"
BRAND_LEGAL_NAME="Ashlar Markets, Inc."
BRAND_SUPPORT_EMAIL="support@example.com"
BRAND_MAILING_ADDRESS="1 Example Plaza, Suite 100, City, ST 00000"

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Search engines are blocked until this is explicitly "true".
NEXT_PUBLIC_ALLOW_INDEXING="false"
# --- Supabase --------------------------------------------------------------
# Project region is US East (decided). See docs/decisions/open-questions.md #6.
NEXT_PUBLIC_SUPABASE_URL=""
# Safe to expose ONLY because RLS is enabled on every table. A table without
# RLS is publicly readable with this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-side only. Bypasses Row Level Security — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=""

# Signs the short-lived database sessions the MCP server mints for external AI
# agents. Supabase dashboard -> Settings -> API -> JWT Settings -> JWT Secret.
#
# Without it /api/mcp refuses every caller with a 503 rather than falling back to
# something that works — a misconfigured auth boundary that still answers is
# worse than one that does not. Everything else in the product is unaffected.
SUPABASE_JWT_SECRET=""

# --- Database tests --------------------------------------------------------
# Only used by the RLS and schema-parity suites. Absent locally means they skip;
# absent in CI is a failure. The application never reads this.
# DATABASE_URL="postgresql://localhost/cairn_test"

# --- AI providers ----------------------------------------------------------
# Routed through apps/web/src/lib/ai/router.ts. No feature calls a provider
# directly, so what leaves the platform is answerable from one file.
#
# Both optional. With neither set, AI features degrade silently: matching still
# scores deterministically, and the thesis read is simply absent. Anthropic is
# tried first, OpenAI second.
#
# What is sent: the anonymised listing teaser and the buyer's own thesis text.
# Never the confidential profile — see docs/agents.md.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# --- Security --------------------------------------------------------------
# "true" sends the Content Security Policy as an enforcing header; anything else
# sends it report-only. Deploy report-only first, walk the app, read the
# violations, then flip this. A CSP that breaks production is a worse outage
# than no CSP is a vulnerability.
CSP_ENFORCE="false"

# Bearer token for /api/cron/due-tasks, the one notification nothing else can
# produce: time passing has no user action behind it, so a scheduler has to call
# in. Unset means the route refuses every caller — a misconfiguration is not
# permission — and due-task reminders simply never go out. Everything else still
# works. Give the same value to whatever calls the route.
CRON_SECRET=""

# --- Email -----------------------------------------------------------------
# Notification email. Without it nothing is sent and notifications are in-app
# only — a seller does not learn about an access request until they sign in.
#
# The sender refuses to send at all until BRAND_SUPPORT_EMAIL and
# BRAND_MAILING_ADDRESS are real, because a commercial email with a placeholder
# postal address is a CAN-SPAM violation rather than an untidy footer.
RESEND_API_KEY=""

# --- Communications (not built) --------------------------------------------
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_MESSAGING_SERVICE_SID=""

# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
