# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in. Never commit real values.
# Full descriptions of every variable live in docs/environment.md.
# ---------------------------------------------------------------------------

# --- Brand -----------------------------------------------------------------
# The company name is not hard-coded anywhere; it is read from here.
NEXT_PUBLIC_BRAND_NAME="Cairn"
NEXT_PUBLIC_BRAND_TAGLINE="Mark the way."
BRAND_LEGAL_NAME="Cairn Markets, Inc."
BRAND_SUPPORT_EMAIL="support@example.com"
BRAND_MAILING_ADDRESS="1 Example Plaza, Suite 100, City, ST 00000"

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Search engines are blocked until this is explicitly "true".
NEXT_PUBLIC_ALLOW_INDEXING="false"
# Renders sample statistics and testimonials on the marketing site with a
# visible "sample data" marker. Must be "false" in production.
NEXT_PUBLIC_DEMO_DATA="true"

# --- Supabase --------------------------------------------------------------
# Project region is US East (decided). See docs/decisions/open-questions.md #6.
NEXT_PUBLIC_SUPABASE_URL=""
# Safe to expose ONLY because RLS is enabled on every table. A table without
# RLS is publicly readable with this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-side only. Bypasses Row Level Security — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Database tests --------------------------------------------------------
# Only used by the RLS and schema-parity suites. Absent locally means they skip;
# absent in CI is a failure. The application never reads this.
# DATABASE_URL="postgresql://localhost/cairn_test"

# --- AI providers (build step 8) -------------------------------------------
# Routed through the model-router abstraction; no agent calls a provider directly.
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""

# --- Communications (build step 7) -----------------------------------------
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_MESSAGING_SERVICE_SID=""
# RESEND_API_KEY=""
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
